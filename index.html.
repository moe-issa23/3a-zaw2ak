
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#fff8ef">
  <title>ع زوقك | 3a Zaw2ak</title>
  <style>
    :root {
      --orange: #ed7837;
      --dark: #29251f;
      --cream: #fff8ef;
      --muted: #786f65;
      --border: #eee1d2;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: var(--cream);
      color: var(--dark);
    }

    header {
      background: white;
      padding: 17px 6%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
    }

    .logo {
      font-size: 25px;
      font-weight: 900;
      color: var(--orange);
    }

    .tag {
      background: #fff0e3;
      color: #a84b17;
      border-radius: 20px;
      padding: 8px 12px;
      font-size: 13px;
    }

    .hero {
      text-align: center;
      padding: 35px 18px 25px;
    }

    .hero h1 {
      font-size: clamp(30px, 7vw, 47px);
      margin: 10px 0;
    }

    .hero h1 span { color: var(--orange); }

    .hero p {
      color: var(--muted);
      line-height: 1.8;
      max-width: 520px;
      margin: auto;
    }

    main {
      width: min(100% - 28px, 680px);
      margin: auto;
      padding-bottom: 35px;
    }

    .card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 20px;
      margin-bottom: 17px;
      box-shadow: 0 5px 20px #49321a08;
    }

    .card h2 {
      font-size: 20px;
      margin: 0 0 17px;
    }

    .field { margin-bottom: 19px; }
    .field:last-child { margin-bottom: 0; }

    label, .label {
      display: block;
      font-weight: bold;
      margin-bottom: 10px;
    }

    .choices {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .choice {
      border: 1px solid var(--border);
      padding: 13px 10px;
      border-radius: 12px;
      cursor: pointer;
      background: white;
      display: flex;
      gap: 8px;
      align-items: center;
      line-height: 1.5;
    }

    .choice:has(input:checked) {
      border: 2px solid var(--orange);
      background: #fff5ec;
      padding: 12px 9px;
    }

    .choice input { accent-color: var(--orange); }

    .price {
      color: var(--orange);
      font-weight: bold;
      margin-right: auto;
      white-space: nowrap;
    }

    select, input[type="text"], input[type="tel"], textarea {
      width: 100%;
      padding: 13px;
      border: 1px solid var(--border);
      border-radius: 10px;
      font: inherit;
      background: white;
      color: var(--dark);
    }

    textarea {
      resize: vertical;
      min-height: 80px;
    }

    .quantity {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .quantity button {
      width: 43px;
      height: 43px;
      font-size: 23px;
      border: none;
      border-radius: 12px;
      background: #fff0e3;
      color: var(--orange);
      cursor: pointer;
    }

    .quantity strong { font-size: 20px; }

    .summary {
      background: #29251f;
      color: white;
      border-radius: 20px;
      padding: 22px;
      position: sticky;
      bottom: 8px;
      box-shadow: 0 8px 30px #0002;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
      color: #e9dfd5;
    }

    .total {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid #ffffff35;
      padding-top: 16px;
      font-weight: bold;
      font-size: 19px;
    }

    .total strong {
      color: #ffb477;
      font-size: 27px;
    }

    .primary {
      width: 100%;
      border: none;
      border-radius: 12px;
      padding: 15px;
      margin-top: 18px;
      font: inherit;
      font-weight: bold;
      cursor: pointer;
      background: var(--orange);
      color: white;
    }

    .primary:active { transform: scale(.99); }

    .note {
      font-size: 12px;
      line-height: 1.7;
      color: var(--muted);
      margin-top: 12px;
    }

    footer {
      text-align: center;
      padding: 22px;
      color: var(--muted);
      font-size: 13px;
    }

    #message {
      margin-top: 15px;
      padding: 12px;
      border-radius: 10px;
      display: none;
      line-height: 1.7;
      overflow-wrap: anywhere;
    }

    @media (max-width: 380px) {
      .card { padding: 15px; }
      .choices { grid-template-columns: 1fr; }
      header { padding: 15px; }
    }
  </style>
</head>

<body>
  <header>
    <div class="logo">🍕 ع زوقك</div>
    <div class="tag">3a Zaw2ak · على ذوقك</div>
  </header>

  <section class="hero">
    <div style="font-size:48px">🍕 🍔 🥤</div>
    <h1>طلبك، <span>على زوقك!</span></h1>
    <p>
      اختار مكوناتك، ركّب وجبتك متل ما بتحب،
      وشوف السعر فورًا قبل ما تطلب.
    </p>
  </section>

  <main>
    <section class="card">
      <h2>🍕 ركّب البيتزا تبعك</h2>

      <div class="field">
        <span class="label">1. حجم البيتزا</span>
        <div class="choices">
          <label class="choice">
            <input type="radio" name="size" value="small" checked>
            <span>صغيرة</span>
            <span class="price">$5</span>
          </label>
          <label class="choice">
            <input type="radio" name="size" value="medium">
            <span>وسط</span>
            <span class="price">$8</span>
          </label>
          <label class="choice">
            <input type="radio" name="size" value="large">
            <span>كبيرة</span>
            <span class="price">$11</span>
          </label>
          <label class="choice">
            <input type="radio" name="size" value="family">
            <span>عائلية</span>
            <span class="price">$15</span>
          </label>
        </div>
      </div>

      <div class="field">
        <span class="label">2. نوع العجينة</span>
        <div class="choices">
          <label class="choice">
            <input type="radio" name="dough" value="0" checked>
            <span>عادية</span>
            <span class="price">مجانًا</span>
          </label>
          <label class="choice">
            <input type="radio" name="dough" value="1.5">
            <span>محشية جبنة</span>
            <span class="price">+$1.50</span>
          </label>
          <label class="choice">
            <input type="radio" name="dough" value="1">
            <span>رقيقة ومقرمشة</span>
            <span class="price">+$1</span>
          </label>
        </div>
      </div>

      <div class="field">
        <span class="label">3. اختار المكونات الإضافية</span>
        <div class="choices">
          <label class="choice">
            <input type="checkbox" name="topping" value="1.5">
            <span>جبنة إضافية</span>
            <span class="price">+$1.50</span>
          </label>
          <label class="choice">
            <input type="checkbox" name="topping" value="1">
            <span>فطر 🍄</span>
            <span class="price">+$1</span>
          </label>
          <label class="choice">
            <input type="checkbox" name="topping" value="1">
            <span>زيتون 🫒</span>
            <span class="price">+$1</span>
          </label>
          <label class="choice">
            <input type="checkbox" name="topping" value="1.5">
            <span>بيبروني</span>
            <span class="price">+$1.50</span>
          </label>
          <label class="choice">
            <input type="checkbox" name="topping" value="1">
            <span>فليفلة</span>
            <span class="price">+$1</span>
          </label>
          <label class="choice">
            <input type="checkbox" name="topping" value="1.5">
            <span>دجاج</span>
            <span class="price">+$1.50</span>
          </label>
        </div>
      </div>

      <div class="field">
        <label for="sauce">4. الصوص</label>
        <select id="sauce">
          <option value="0">صوص طماطم — مجانًا</option>
          <option value="0.5">باربكيو — +$0.50</option>
          <option value="0.5">رانش — +$0.50</option>
          <option value="0.75">صوص حار — +$0.75</option>
        </select>
      </div>

      <div class="field">
        <span class="label">5. الكمية</span>
        <div class="quantity">
          <button type="button" id="minus" aria-label="إنقاص الكمية">−</button>
          <strong id="qty">1</strong>
          <button type="button" id="plus" aria-label="زيادة الكمية">+</button>
        </div>
      </div>

      <div class="field">
        <label for="notes">ملاحظات للمطبخ (اختياري)</label>
        <textarea id="notes" placeholder="مثلاً: بلا زيتون، جبنة زيادة..."></textarea>
      </div>
    </section>

    <section class="card">
      <h2>📍 معلومات التوصيل</h2>
      <div class="field">
        <label for="customer">اسمك</label>
        <input id="customer" type="text" placeholder="الاسم الكامل">
      </div>
      <div class="field">
        <label for="phone">رقم الهاتف</label>
        <input id="phone" type="tel" placeholder="مثلاً: 03 123 456">
      </div>
      <div class="field">
        <label for="address">منطقتك وعنوانك</label>
        <input id="address" type="text" placeholder="البلدة، الشارع، المبنى">
      </div>
      <div class="field">
        <label for="delivery">طريقة الاستلام</label>
        <select id="delivery">
          <option value="0">استلام من المحل — مجانًا</option>
          <option value="2">توصيل — +$2 (سعر تجريبي)</option>
          <option value="3">توصيل بعيد — +$3 (سعر تجريبي)</option>
        </select>
      </div>
    </section>

    <section class="summary">
      <h2 style="margin-top:0">🧾 ملخص طلبك</h2>
      <div class="summary-row">
        <span>البيتزا الواحدة</span>
        <span id="unitPrice">$5.00</span>
      </div>
      <div class="summary-row">
        <span>الكمية</span>
        <span id="qtySummary">1</span>
      </div>
      <div class="summary-row">
        <span>التوصيل</span>
        <span id="deliveryPrice">$0.00</span>
      </div>
      <div class="total">
        <span>المجموع</span>
        <strong id="total">$5.00</strong>
      </div>
      <button class="primary" id="orderBtn" type="button">
        جهّز طلبي 📲
      </button>
      <p class="note">
        الأسعار بالدولار وهي أسعار تجريبية قابلة للتعديل.
        هذا النموذج لا يرسل الطلب إلى مطعم تلقائيًا.
      </p>
      <div id="message" role="status"></div>
    </section>
  </main>

  <footer>صُنع بحب في لبنان 🇱🇧 · ع زوقك © 2026</footer>

  <script>
    const basePrices = {
      small: 5,
      medium: 8,
      large: 11,
      family: 15
    };

    let quantity = 1;

    const money = value => "$" + value.toFixed(2);

    function calculate() {
      const size = document.querySelector(
        'input[name="size"]:checked'
      ).value;

      const dough = Number(document.querySelector(
        'input[name="dough"]:checked'
      ).value);

      const toppings = [...document.querySelectorAll(
        'input[name="topping"]:checked'
      )].reduce((sum, item) => sum + Number(item.value), 0);

      const sauce = Number(document.getElementById("sauce").value);
      const delivery = Number(document.getElementById("delivery").value);

      const unit = basePrices[size] + dough + toppings + sauce;
      const total = unit * quantity + delivery;

      document.getElementById("qty").textContent = quantity;
      document.getElementById("qtySummary").textContent = quantity;
      document.getElementById("unitPrice").textContent = money(unit);
      document.getElementById("deliveryPrice").textContent = money(delivery);
      document.getElementById("total").textContent = money(total);

      return { size, dough, toppings, sauce, delivery, unit, total };
    }

    document.querySelectorAll("input, select").forEach(element => {
      element.addEventListener("change", () => {
        document.getElementById("message").style.display = "none";
        calculate();
      });
    });

    document.getElementById("minus").addEventListener("click", () => {
      quantity = Math.max(1, quantity - 1);
      calculate();
    });

    document.getElementById("plus").addEventListener("click", () => {
      quantity = Math.min(20, quantity + 1);
      calculate();
    });

    document.getElementById("orderBtn").addEventListener("click", () => {
      const name = document.getElementById("customer").value.trim();
      const phone = document.getElementById("phone").value.trim();
      const address = document.getElementById("address").value.trim();
      const notes = document.getElementById("notes").value.trim();
      const delivery = document.getElementById("delivery").value;
      const result = calculate();

      const message = document.getElementById("message");
      message.style.display = "block";

      if (!name || !phone || (delivery !== "0" && !address)) {
        message.style.background = "#fff0e3";
        message.style.color = "#8c3d12";
        message.textContent =
          "باقي تعبي اسمك ورقم هاتفك، وعنوانك إذا اخترت التوصيل.";
        return;
      }

      const sizeNames = {
        small: "صغيرة",
        medium: "وسط",
        large: "كبيرة",
        family: "عائلية"
      };

      const doughName = document.querySelector(
        'input[name="dough"]:checked'
      ).parentElement.innerText.trim();

      const selectedToppings = [
        ...document.querySelectorAll('input[name="topping"]:checked')
      ].map(item => item.parentElement.innerText.trim());

      const summary = [
        "طلب جديد - ع زوقك",
        "الاسم: " + name,
        "الهاتف: " + phone,
        "العنوان: " + (address || "استلام من المحل"),
        "المنتج: بيتزا",
        "الحجم: " + sizeNames[result.size],
        "العجينة: " + doughName,
        "الإضافات: " + (selectedToppings.join("، ") || "بدون إضافات"),
        "الصوص: " + document.getElementById("sauce").selectedOptions[0].text,
        "الكمية: " + quantity,
        "ملاحظات: " + (notes || "لا يوجد"),
        "المجموع: " + money(result.total)
      ].join("\n");

      message.style.background = "#e8f7e9";
      message.style.color = "#205c2a";
      message.textContent =
        "تم تجهيز ملخص الطلب على جهازك. اضغط مطولًا لنسخه، أو استخدم زر المشاركة في متصفحك إذا توفر. الطلب لم يُرسل إلى المطعم.";

      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(summary).then(() => {
          message.textContent =
            "تم نسخ ملخص الطلب! لكنه لم يُرسل إلى المطعم بعد.\n\n" + summary;
        }).catch(() => {
          message.textContent = summary;
        });
      } else {
        message.textContent = summary;
      }
    });

    calculate();
  </script>
</body>
</html>
